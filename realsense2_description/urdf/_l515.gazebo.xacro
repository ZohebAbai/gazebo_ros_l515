<?xml version="1.0"?>

<!--
License: Apache 2.0. See LICENSE file in root directory.
Copyright(c) 2017 PAL Robotics, S.L. All Rights Reserved

This is the Gazebo URDF model for the Intel RealSense L515 camera
-->
  
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="gazebo_l515" params="camera_name reference_link topics_ns depth_optical_frame color_optical_frame infrared_optical_frame publish_pointcloud:=true" >

    <!-- Load parameters to model's main link-->
    <xacro:property name="deg_to_rad" value="0.01745329251994329577" />
    <gazebo reference="${reference_link}">
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <!--<mu>1</mu>-->
      <mu2>1</mu2>
      <fdir1>0 0 0</fdir1>
      <!--<slip1>0</slip1>
      <slip2>0</slip2>-->
      <kp>1e+13</kp>
      <kd>1</kd>
      <!--<max_vel>0.01</max_vel>
      <min_depth>0</min_depth>-->
      <!-- Color resolution + rate sized for the training pipeline.
           Gemma's vision encoder downsamples to ~448px on its long edge,
           and frame_capture runs at 5 Hz, so 640×480 @ 10 Hz already
           oversamples both ends. The original 1920×1080 @ 30 Hz pinned
           the headless EGL renderer at RTF ~0.4 and produced repeated
           frames because gz-sim was publishing the previously-rendered
           buffer whenever the new render didn't land in time. -->
      <sensor name="${camera_name}color" type="camera">
        <topic>/${topics_ns}/color</topic>
        <camera name="${camera_name}">
          <horizontal_fov>${71.01*deg_to_rad}</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
      </sensor>
      <!-- Infra + depth streams stay declared so the realsense_gazebo_plugin
           below keeps its three-channel plumbing intact, but their render
           rate drops to 1 Hz: nothing in the training or inference pipeline
           consumes them, and rendering 1024×768 at 90 Hz on the same GPU
           starves the color sensor of frames. -->
      <sensor name="${camera_name}ired" type="camera">
        <topic>/${topics_ns}/infra</topic>
        <camera name="${camera_name}">
          <horizontal_fov>${70*deg_to_rad}</horizontal_fov>
          <image>
            <width>1024</width>
            <height>768</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>0</visualize>
      </sensor>
      <sensor name="${camera_name}depth" type="depth">
        <topic>/${topics_ns}/depth</topic>
        <camera name="${camera_name}">
          <horizontal_fov>${70*deg_to_rad}</horizontal_fov>
          <image>
            <width>1024</width>
            <height>768</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>0</visualize>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin name="realsense_gazebo_plugin::RealSensePluginHarmonic" filename="realsense_gazebo_plugin">
        <prefix>${camera_name}</prefix>
        <!-- Match the gz-sim sensor update rates above so the plugin doesn't
             throttle harder than the renderer is producing. -->
        <depthUpdateRate>1.0</depthUpdateRate>
        <colorUpdateRate>10.0</colorUpdateRate>
        <infraredUpdateRate>1.0</infraredUpdateRate>
        <depthTopicName>/camera/depth/image_rect_raw</depthTopicName>
        <depthCameraInfoTopicName>/camera/depth/camera_info</depthCameraInfoTopicName>
        <colorTopicName>/camera/color/image_raw</colorTopicName>
        <colorCameraInfoTopicName>/camera/color/camera_info</colorCameraInfoTopicName>
        <infraredTopicName>/camera/infra/image_raw</infraredTopicName>
        <infraredCameraInfoTopicName>/camera/infra/camera_info</infraredCameraInfoTopicName>
        <colorOpticalframeName>${color_optical_frame}</colorOpticalframeName>
        <depthOpticalframeName>${depth_optical_frame}</depthOpticalframeName>
        <infraredOpticalframeName>${infrared_optical_frame}</infraredOpticalframeName>
        <rangeMinDepth>0.2</rangeMinDepth>
        <rangeMaxDepth>10.0</rangeMaxDepth>
        <pointCloud>${publish_pointcloud}</pointCloud>
        <pointCloudTopicName>/camera/depth/color/points</pointCloudTopicName>
        <pointCloudCutoff>0.25</pointCloudCutoff>
        <pointCloudCutoffMax>9.0</pointCloudCutoffMax>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
